# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Raw materials and scratch assets
preparation_materials/
temp_gre_docs/
scratch/

# Large audio assets (hosted on GitHub Releases instead)
public/audio/*.mp3

# Python cache artifacts
__pycache__/
*.pyc

# Content-extraction run outputs (regenerable; raw source lives outside the repo)
tmp/

# Heavy runtime media — active content assets too large for version control.
# canonical/v2 packages reference assets/ via runtime paths; public/wp-content
# mirrors the raw source's WordPress uploads and is served by the dev server.
src/data/canonical/v2/assets/
public/wp-content/
public/videos
