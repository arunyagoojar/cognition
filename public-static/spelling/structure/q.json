:["qui","et"],"etymology":"L. quietus, p. p. pf quiescere to rest, keep quiet; akin to quies rest, and prob. to E. while, n. See While, and cf. Coy, a., Quiesce, Quietus, Quit, a., Quite, Requiem.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietism":{"syllables":["qui","et","ism"],"etymology":"Cf. F. quiétisme.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietist":{"syllables":["qui","et","ist"],"etymology":"Cf. F. quiétiste.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietly":{"syllables":["qui","et","ly"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietness":{"syllables":["qui","et","ness"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietude":{"syllables":["qui","e","tude"],"etymology":"L. quietudo: cf. F. quiétude.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quietus":{"syllables":["qui","e","tus"],"etymology":"LL. quietus quit, discharged, L., at rest, quiet, dead. See Quiet, a., and cf. Quit, a.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quill":{"syllables":["quill"],"etymology":"Perhaps fr. F. quille ninepin (see Kayless); but cf. also G. kiel a quill. MHG. kil, and Ir. cuille a quill.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quillwort":{"syllables":["quill","wort"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quilt":{"syllables":["quilt"],"etymology":"OE. quilte, OF. cuilte, L. culcita bed, cushion, mattress. Cf. 2d Counterpoint, Cushion.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quilting":{"syllables":["quilt","ing"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quin":{"syllables":["quin"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quince":{"syllables":["quince"],"etymology":"Prob. a pl. from OE. quyne, coin, OF. coin, cooin, F. coing, from L. Cydonius a quince tree, as adj., Cydonian, Gr. Quiddany.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinidine":{"syllables":["quin","i","dine"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinine":{"syllables":["qui","nine"],"etymology":"F. (cf. Sp. quinina), fr. Sp. quina, or quinaquina, Peruvian bark, fr. Peruv. kina, quina, bark. Cf. Kinic.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinone":{"syllables":["qui","none"],"etymology":"Quinine + ketone.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinquagesima":{"syllables":["quin","qua","ges","i","ma"],"etymology":"L., fr. quinquagesimus the fiftieth, akin to quinquaginta fifty, quinque five. See Five.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinquefoliate":{"syllables":["quin","que","fo","li","ate"],"etymology":"Quinque- + foliate, -ated: cf. F. quinquéfolié, L. quinquefolius.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765","roots":[{"term":"Quinque-","meaning":"A combining form meaning five, five times, fivefold; as, quinquefid, five-cleft; quinquedentate, five-toothed."}]},"quinquennium":{"syllables":["quin","quen","ni","um"],"etymology":"L.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quinsy":{"syllables":["quin","sy"],"etymology":"Contr. fr. squinancy, F. esquinancie, L. cynanche a sort of sore throat, Gr. synanche sore throat, Gr. Hound, Anger, and Cynanche.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quint":{"syllables":["quint"],"etymology":"F. quinte, fr. L. quintus, quinta, the fifth, quinque five. See Five.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintal":{"syllables":["quin","tal"],"etymology":"F., fr. Sp. quintal, fr. Ar. qintar a weight of 100 lbs., prob. fr. L. centenarius consisting of a hundred, fr. centeni a hundred each, fr. centum a hundred. See Hundred, and cf. Kentle.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintessence":{"syllables":["quin","tes","sence"],"etymology":"F., fr. L. quinta essentia fifth essence. See Quint, and Essence.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintessential":{"syllables":["quin","tes","sen","tial"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintet":{"syllables":["quin","tet"],"etymology":"It. quintetto, dim. of quinto the fifth, a fifth part, from L. quintus the fifth: cf. F. quintette. See Quint.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintette":{"syllables":[],"etymology":"It. quintetto, dim. of quinto the fifth, a fifth part, from L. quintus the fifth: cf. F. quintette. See Quint.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintuple":{"syllables":["quin","tu","ple"],"etymology":"L. quintus fifth: cf. F. quintuple, L. quintuplex. Cf. Quadruple.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quintuplet":{"syllables":["quin","tu","plet"],"etymology":"From Quintuple.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quip":{"syllables":["quip"],"etymology":"Cf. W. chwip a quick flirt or turn, chwipio to whip, to move briskly, and E. whip. Cf. Quib, Quibble.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quipu":{"syllables":["qui","pu"],"etymology":"Peruv.quipu a knot.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quire":{"syllables":["quire"],"etymology":"OE. quaer, quair, OF. quayer, cayer, caïer, F. cahier, a book of loose sheets, a quarter of a quire, LL. quaternus, quaternum, sheets of paper packed together, properly, four together, fr. L. quaterni four each, by fours, quattuor, four. See Four and cf. Cahier.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quirk":{"syllables":["quirk"],"etymology":"Cf W. chwiori to turn briskly, or E. queer.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quirky":{"syllables":["quirk","y"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quirt":{"syllables":["quirt"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quit":{"syllables":["quit"],"etymology":"OE. quite, OF. quite, F. quitte. See Quit, v., Quirt.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quitclaim":{"syllables":["quit","claim"],"etymology":"Quit, a. + claim.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quite":{"syllables":["quite"],"etymology":"F. quite discharged, free, clear; cf. OF. quitement freely, frankly, entirely. See Quit, a.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quits":{"syllables":["quits"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quittance":{"syllables":["quit","tance"],"etymology":"OE. quitaunce, OF. quitance, F. quittance. See Quit, v. t.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quitter":{"syllables":["quit","ter"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quiver":{"syllables":["quiv","er"],"etymology":"Akin to AS. cwiferlice anxiously; cf. OD. kuiven, kuiveren. Cf. Quaver.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quixotic":{"syllables":["quix","ot","ic"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quixotically":{"syllables":["quix","ot","ic","al","ly"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quixotism":{"syllables":["quix","ot","ism"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quiz":{"syllables":["quiz"],"etymology":"It is said that Daly, the manager of a Dublin playhouse, laid a wager that a new word of no meaning should be the common talk and puzzle of the city in twenty-fours. In consequence of this the letters q u i z were chalked by him on all the walls of Dublin, with an effect that won the wager. Perhaps, however, originally a variant of whiz, and formerly the name of a popular game.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quizzer":{"syllables":["quiz","zer"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quizzical":{"syllables":["quiz","zic","al"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quodlibet":{"syllables":["quod","li","bet"],"etymology":"L., what you please.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quoin":{"syllables":["quoin"],"etymology":"See Coin, and cf. Coigne.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quoit":{"syllables":["quoit"],"etymology":"OE. coite; cf. OF. coitier to spur, press, (assumed) LL. coctare, fr. L. coquere, coctum, to cook, burn, vex, harass, E. cook, also W. coete a quoit.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quondam":{"syllables":["quon","dam"],"etymology":"L., formerly.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quorum":{"syllables":["quo","rum"],"etymology":"L., of whom, gen. pl. of qui who, akin to E. who. See the Note below.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quota":{"syllables":["quo","ta"],"etymology":"LL., fr. L. quota (sc. pars), fr.quotus which or what in number, of what number, how many, fr. quot how many, akin to quis, qui, who: cf. It. quota a share. See Who.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quotable":{"syllables":["quot","a","ble"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quotation":{"syllables":["quo","ta","tion"],"etymology":"From Quote.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quote":{"syllables":["quote"],"etymology":"OF. quoter, F. coter to letter, number, to quote, LL. quotare to divide into chapters and verses, fr. L. quotus. See Quota.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quoter":{"syllables":["quot","er"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quotidian":{"syllables":["quo","tid","i","an"],"etymology":"OE. cotidian, L. quotidianus, fr. quotidie daily; quotus how many + dies day: cf. OF. cotidien, F. quotidien. See Quota, Deity.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quotient":{"syllables":["quo","tient"],"etymology":"F., fr. L. quoties how often, how many times, fr. quot how many. See Quota.","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"},"quran":{"syllables":["qu","ran"],"etymology":"","source":"Webster’s Unabridged Dictionary (1913)","sourceUrl":"https://www.gutenberg.org/ebooks/29765"}}
